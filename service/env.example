# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. .env.local 은 git에 올라가지 않는다.

# Neon 연결 문자열 (Vercel에서 Neon을 연결하면 자동으로 들어간다)
DATABASE_URL=

# 로그인 세션 서명 키: 32자 이상 임의 문자열
SESSION_SECRET=

# Google AI Studio 에서 발급
GEMINI_API_KEY=
# 비워 두면 gemini-flash-latest 사용
GEMINI_MODEL=

# 데모 계정 공통 비밀번호(시드 스크립트가 사용)
DEMO_PASSWORD=
# 회원가입 화면에서 쓰는 초대 코드
INVITE_CODE=
# Vercel Cron 인증용 임의 문자열(Vercel 환경변수에만 넣으면 된다)
CRON_SECRET=
