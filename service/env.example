# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. .env.local 은 git에 올라가지 않는다.
# Supabase 대시보드 > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 클라이언트 코드나 git에 넣지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio 에서 발급
GEMINI_API_KEY=
# 비워 두면 gemini-flash-latest 사용
GEMINI_MODEL=

# 데모 계정 공통 비밀번호(시드 스크립트가 사용)
DEMO_PASSWORD=
# 회원가입 화면에서 쓰는 초대 코드
INVITE_CODE=
# Vercel Cron 인증용 임의 문자열(Vercel 환경변수에만 넣으면 된다)
CRON_SECRET=
